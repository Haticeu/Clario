# Bu dosyayı .env olarak kopyalayın; tüm değerler opsiyoneldir.

# Arayüzün API'ye ulaştığı yol. Varsayılan "/api": Vite geliştirme sunucusu bu istekleri
# API_PROXY_TARGET adresine iletir. Bu sayede uygulama aynı ağdaki diğer cihazlardan da çalışır.
# API'ye doğrudan bağlanmak isterseniz tam adres verin (ör. http://localhost:4000/api).
VITE_API_BASE_URL=/api

# Vite'in /api isteklerini ileteceği backend adresi (varsayılan: http://localhost:4000)
API_PROXY_TARGET=http://localhost:4000

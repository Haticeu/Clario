# Backend ayarları. Bu dosyayı .env olarak kopyalayın; tüm değerler opsiyoneldir.

# API'nin dinleyeceği port (varsayılan: 4000)
PORT=4000

# Veri klasörü (varsayılan: data). İçinde:
#   system.db        hesaplar — kişisel veri yok (e-posta yalnızca anahtarlı özet olarak)
#   server.key       e-posta özetleri için sunucu anahtarı (silmeyin; silinirse kimse giriş yapamaz)
#   users/<id>.clario her hesabın AES-256-GCM ile şifrelenmiş verisi (anahtar parolasından türetilir)
# Yedeklerken klasörün tamamını yedekleyin.
DATA_DIR=data

# Frontend'e başka bir adresten (farklı origin) erişilecekse izin verilen adresler, virgülle ayrılmış.
# Varsayılan: hiçbiri — Vite proxy veya ters vekil ile aynı adresten erişildiği için gerekmez.
# CORS_ORIGINS=https://clario.example.com

# Oturum çerezinin Secure bayrağı. İnternete açık kurulumda HTTPS arkasında true yapın.
# Tanımsız: istek HTTPS ise Secure (yerel ağda http ile de çalışır).
# COOKIE_SECURE=true

# Hatalı giriş koruması (dakika). 0 veya tanımsız: kapalı. Örn. 15 → 5 hatalı parolada hesap 15 dakika kilitlenir
# ve aynı IP'den 15 dakikada en fazla 20 giriş/kayıt denemesi yapılabilir. İnternete açık kurulumda açın.
# LOGIN_LOCKOUT_MINUTES=15

# nginx / Caddy gibi bir ters vekil (reverse proxy) arkasındaysa true: HTTPS ve istemci IP'si vekilden okunur.
# TRUST_PROXY=true

# Arayüzün tarayıcıda açıldığı adres (varsayılan: http://localhost:5180). Google girişinin dönüş adresi
# bundan üretilir: <APP_URL>/api/auth/google/callback
# APP_URL=http://localhost:5180

# Google ile giriş (opsiyonel). Kurulum adımları: README → Hesaplar ve güvenlik → Google ile giriş.
# İkisi de tanımlıysa giriş ekranında "Google ile devam et" düğmesi görünür.
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# Not: Harici yapay zekâ servisi veya API anahtarı gerekmez. Asistan ve gündem Clario'nun kendi kurallarıyla çalışır;
# gündem için yalnızca ücretsiz RSS haber kaynaklarına ve ECB döviz kurlarına internet erişimi gerekir.
